# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Razorpay Payment Gateway credentials for Pro (INR 99/mo) & Premium (INR 199/mo) plans.
# Keep RAZORPAY_KEY_SECRET strictly on the server; never expose it to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
